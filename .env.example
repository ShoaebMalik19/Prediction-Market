# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Your wallet private key (without 0x prefix is fine too)
PRIVATE_KEY=your_private_key_here

# ── ProofMarket ──────────────────────────────────────────────────────────────
# Deployed contract address (fill after running: npm run deploy:proofmarket)
CONTRACT_ADDRESS=

# Shardeum RPC URLs (defaults already set in hardhat.config.js)
# Uncomment to override:
# SHARDEUM_TESTNET_8083_RPC=https://api-testnet.shardeum.org/
# SHARDEUM_TESTNET_RPC=https://api-mezame.shardeum.org
# SHARDEUM_MAINNET_RPC=https://api.shardeum.org
